#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

readonly BACKUP_ROOT="${BACKUP_ROOT:-/srv/backups/agentic-accounting/daily}"
readonly RESTORE_IMAGE="${RESTORE_IMAGE:-supabase/postgres:15.8.1.085@sha256:af083ef64d0408c8f098ee6f5c364a59b26f36fbc0f3a334a62c5c1d57362e9b}"
readonly RESTORE_CONTAINER="agentic-accounting-restore-test-$$"
readonly ARCHIVE_PATH="${1:-$({ find "$BACKUP_ROOT" -maxdepth 1 -type f -name 'postgres-*.dump' -printf '%T@ %p\n' 2>/dev/null || true; } | sort -nr | head -n 1 | cut -d' ' -f2-)}"

if [ -z "$ARCHIVE_PATH" ] || [ ! -f "$ARCHIVE_PATH" ]; then
  echo "No PostgreSQL custom archive found: ${ARCHIVE_PATH:-<none>}" >&2
  exit 1
fi

if [ -f "$ARCHIVE_PATH.sha256" ]; then
  sha256sum --check "$ARCHIVE_PATH.sha256" >/dev/null
fi

restore_password="$(openssl rand -hex 24)"

cleanup() {
  docker rm -f "$RESTORE_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker run -d --name "$RESTORE_CONTAINER" \
  -e POSTGRES_DB=postgres \
  -e POSTGRES_PASSWORD="$restore_password" \
  "$RESTORE_IMAGE" >/dev/null

ready=0
for _ in $(seq 1 60); do
  if docker exec -e PGPASSWORD="$restore_password" "$RESTORE_CONTAINER" \
    pg_isready -h 127.0.0.1 -U supabase_admin -d postgres >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 2
done

if [ "$ready" -ne 1 ]; then
  docker logs "$RESTORE_CONTAINER" >&2
  echo "Disposable Supabase PostgreSQL did not become ready." >&2
  exit 1
fi

docker cp "$ARCHIVE_PATH" "$RESTORE_CONTAINER:/tmp/restore.dump"
docker exec -e PGPASSWORD="$restore_password" "$RESTORE_CONTAINER" \
  pg_restore -h 127.0.0.1 -U supabase_admin -d postgres \
    --clean --if-exists --no-owner --no-privileges --exit-on-error \
    /tmp/restore.dump

validation="$(docker exec -e PGPASSWORD="$restore_password" "$RESTORE_CONTAINER" \
  psql -h 127.0.0.1 -U supabase_admin -d postgres -Atc \
    "select to_regclass('public.organizations') is not null,
            to_regclass('public.accounts') is not null,
            to_regclass('public.journal_entries') is not null,
            to_regclass('auth.users') is not null")"

if [ "$validation" != "t|t|t|t" ]; then
  echo "Restore validation failed: $validation" >&2
  exit 1
fi

echo "Restore rehearsal passed: $ARCHIVE_PATH"
